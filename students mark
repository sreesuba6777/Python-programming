print("===== STUDENT MARK CALCULATION =====")

name = input("Enter student name: ")

m1 = int(input("Enter mark for Subject 1: "))
m2 = int(input("Enter mark for Subject 2: "))
m3 = int(input("Enter mark for Subject 3: "))
m4 = int(input("Enter mark for Subject 4: "))
m5 = int(input("Enter mark for Subject 5: "))

total = m1 + m2 + m3 + m4 + m5
average = total / 5

print("\nStudent Name:", name)
print("Total Marks:", total)
print("Average:", average)

if average >= 90:
    print("Grade: A")
elif average >= 75:
    print("Grade: B")
elif average >= 60:
    print("Grade: C")
elif average >= 50:
    print("Grade: D")
else:
    print("Grade: Fail")

print("Thank You")